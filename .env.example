# Optional: the app already contains its safe public connection settings.
# Use these only if you later move RuJe IA to another data project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Required on Vercel for generating academic work with Google Gemini.
# Create it at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional alternative for deployments hosted by Lovable.
LOVABLE_API_KEY=

# Pagar API — server-only credentials. Never prefix these with VITE_.
PAGAR_API_BASE_URL=https://api.pagar.co.mz/api/v1
PAGAR_API_KEY=
PAGAR_SIGNING_SECRET=
PAGAR_WEBHOOK_SECRET=
